# Same line endings on every OS: text files are normalized to LF in the repository and checked out
# with the platform's line ending, except files that must stay LF everywhere.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.html text eol=lf
bin/mt text eol=lf

*.png binary
*.jpg binary
*.webm binary
*.zip binary
*.db binary
